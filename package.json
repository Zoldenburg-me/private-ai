{
  "name": "private-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e:rea": "npx -y rea-agents capture-browser-scenario tests/e2e/rea-own-app-scenario.json --json > /tmp/rea-capture.json && node tests/e2e/check-rea-capture.mjs /tmp/rea-capture.json",
    "test:integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://pai:pai@127.0.0.1:5432/pai_test} TEST_REDIS_URL=${TEST_REDIS_URL:-redis://127.0.0.1:6379/1} vitest run"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "ioredis": "^6.0.0",
    "next": "^15.5.0",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.1.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
