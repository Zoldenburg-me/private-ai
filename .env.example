# Required in production: random >=32 chars, signs anonymous session tokens
SESSION_SECRET=
# Dev/test only: enable the built-in mock enclave provider (never in production)
MOCK_PROVIDER=0
MOCK_BASE_URL=http://127.0.0.1:3000/api/mock/v1
# --- docker-compose (docker-compose.yml builds DATABASE_URL / REDIS_URL from these) ---
POSTGRES_PASSWORD=
# Published app port; bound to localhost by default (put a TLS reverse proxy in front)
APP_BIND=127.0.0.1
APP_PORT=3000

# Persistence. Unset = in-memory (dev/test only; refused in production unless PAI_ALLOW_MEMORY_STORE=1).
# If set but unreachable, requests fail closed with 503.
DATABASE_URL=
REDIS_URL=
# Apply migrations/*.sql automatically on first DB use (default on); set 0 to manage them yourself
PAI_AUTO_MIGRATE=1
PAI_ALLOW_MEMORY_STORE=0
# Server-side entitlement seed (dev/ops override; payments set entitlements in the DB), e.g. {"<session id>":"pro"}
ENTITLEMENTS={}
# Set to 'off' to disable even metadata logs
PAI_LOG=on
# Default provider id (see lib/providers.ts): near | phala | tinfoil | privatemode | redpill | custom
DEFAULT_PROVIDER=near
# NEAR AI Cloud (TEE, OpenAI-compatible) - https://cloud.near.ai
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=Qwen/Qwen3.8-27B
# Phala confidential AI - https://inference.phala.com
PHALA_API_KEY=
PHALA_BASE_URL=https://inference.phala.com/v1
PHALA_MODEL=
# Tinfoil
TINFOIL_API_KEY=
TINFOIL_BASE_URL=
TINFOIL_MODEL=
# Privatemode (Edgeless) - usually via local privatemode-proxy
PRIVATEMODE_API_KEY=
PRIVATEMODE_BASE_URL=http://localhost:8080/v1
PRIVATEMODE_MODEL=
# RedPill gateway
REDPILL_API_KEY=
REDPILL_BASE_URL=https://api.redpill.ai/v1
REDPILL_MODEL=
# Any other OpenAI-compatible endpoint
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
# Passkeys (WebAuthn). Required in production; dev derives them from the request URL.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_NAME=Private AI
# Stripe (test mode keys for dev). We store only customer/subscription ids + status, never card data.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_YEARLY=
# Public base URL for Stripe return URLs (required in production), e.g. https://chat.example.com
APP_URL=
# Abuse limits (Redis counters by route or account id, never IP). Defaults shown.
PAI_LIMIT_NEW_SESSIONS_PER_MIN=600
PAI_LIMIT_PASSKEY_LOGINS_PER_MIN=300
PAI_LIMIT_ACCOUNT_ACTIONS_PER_HOUR=20
