# Production TLS reverse proxy for {$DOMAIN} (required, set in .env). Runs on the host network so
# {remote_host} is the real client IP (docker-proxy would hide it behind the bridge gateway).
# Privacy: no access log at all, and IPs/headers are stripped from every other log line
# (errors, upstream failures). Rate-limit state is per client, in memory only, gone after a restart.
{
	admin off
	order rate_limit before reverse_proxy
	log default {
		output stdout
		# Go's net/http messages ("TLS handshake error from <ip>") put the IP in the message text.
		exclude http.stdlib
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
			}
		}
	}
}

{$DOMAIN} {
	# Rate-limit key: IPv4 as is, IPv6 as its /64 (one host usually owns the whole /64).
	# Go prints IPv6 compressed (RFC 5952), so each rule handles one position of "::" and
	# expands it to the four /64 hextets. First match wins; tests/caddy-ratelimit-key.test.ts checks these.
	map {remote_host} {client_key} {
		~^([0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}):.*$ "${1}"
		~^([0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4})::.*$ "${1}:0"
		~^([0-9a-f]{1,4}:[0-9a-f]{1,4})::([0-9a-f]{1,4}):[0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}$ "${1}:0:${2}"
		~^([0-9a-f]{1,4}:[0-9a-f]{1,4})::.*$ "${1}:0:0"
		~^([0-9a-f]{1,4})::([0-9a-f]{1,4}:[0-9a-f]{1,4}):[0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}$ "${1}:0:${2}"
		~^([0-9a-f]{1,4})::([0-9a-f]{1,4}):[0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}$ "${1}:0:0:${2}"
		~^([0-9a-f]{1,4})::.*$ "${1}:0:0:0"
		~^::([0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}):[0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}$ "0:${1}"
		~^::([0-9a-f]{1,4}:[0-9a-f]{1,4}):[0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}$ "0:0:${1}"
		~^::([0-9a-f]{1,4}):[0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}$ "0:0:0:${1}"
		~^::.*$ "0:0:0:0"
		~^(.*)$ "${1}"
	}

	rate_limit {
		zone session {
			match {
				path /api/session /api/session/
			}
			key {client_key}
			events 60
			window 1m
		}
		zone passkey_login {
			match {
				path /api/auth/passkey/login/*
			}
			key {client_key}
			events 60
			window 1m
		}
	}

	reverse_proxy 127.0.0.1:{$APP_PORT:3000} {
		# The app never needs the client IP; do not hand it over.
		header_up -X-Forwarded-For
		header_up -X-Real-IP
		header_up -Forwarded
	}
}
